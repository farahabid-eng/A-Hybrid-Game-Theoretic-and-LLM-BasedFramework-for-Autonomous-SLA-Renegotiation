# LLM Provider API Keys (use at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRALAI_API_KEY=

# Model Configuration (per role)
# Examples: gpt-4o, claude-sonnet-4-20250514, mistral-large-latest
CLIENT_MODEL=gpt-4o
PROVIDER_MODEL=gpt-4o
PROFILING_MODEL=gpt-4o-mini
RC_MODEL=gpt-4o-mini

# Negotiation Parameters
MAX_NEGOTIATION_ROUNDS=10
